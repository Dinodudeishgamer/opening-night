# Edge Function secrets. Copy to supabase/functions/.env for local serving
# (that file is git-ignored). For the hosted project, set them with
# `supabase secrets set NAME=value`. Never put these in the root .env or in
# any EXPO_PUBLIC_* variable: the mobile app must not receive them.

# HMAC-SHA-256 key for invite codes. At least 32 characters of random data,
# e.g. the output of `openssl rand -base64 48`. Changing it invalidates every
# outstanding invite code.
INVITE_CODE_HMAC_SECRET=

# TMDB credential for the tmdb function: a v3 API key or a v4 read access token.
TMDB_API_KEY=

# Optional. Only if Expo enhanced push security is enabled for the project.
EXPO_ACCESS_TOKEN=

# Optional. Payment-escalation SMS is sent only when all three are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
