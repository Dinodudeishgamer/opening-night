# Opening Night mobile app. Copy to .env and fill in.
#
# Both values are public by design: they are inlined into the app bundle.
# Never put a secret here. Secret keys, the invite-code HMAC secret, and the
# TMDB key live only in Supabase (Edge Function secrets and Vault).
EXPO_PUBLIC_SUPABASE_URL=https://vabgqjbgkhovgzylhezp.supabase.co
# Project Settings > API Keys > Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
